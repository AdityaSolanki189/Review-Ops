# App Configuration
NEXT_PUBLIC_APP_NAME="ReviewOps"
NEXT_PUBLIC_APP_DESCRIPTION="Review analytics for Azzurro Hotels Sydney"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database — local development (Docker on port 5433)
DATABASE_URL="postgresql://reviewops:reviewops@localhost:5433/reviewops"

# Database — Neon production / preview (set in Vercel dashboard, not committed)
# App runtime: pooled endpoint (-pooler host)
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Migrations only: direct endpoint (no -pooler)
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Upstash Redis — optional read cache (dashboard falls back to Postgres when unset)
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxx"

# Environment
NODE_ENV="development"

# OpenRouter (optional — enables AI review insights and weekly briefing)
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MODEL="openai/gpt-4o-mini"

# Scraper (optional)
# SCRAPE_HEADED=1
