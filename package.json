{
    "name": "review-ops",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome lint . --fix",
        "check": "biome check .",
        "format": "biome format . --write",
        "spell": "cspell \"src/**/*.{js,jsx,ts,tsx,md,mdx}\" \"*.{js,jsx,ts,tsx,md,mdx}\"",
        "spell:fix": "cspell \"src/**/*.{js,jsx,ts,tsx,md,mdx}\" \"*.{js,jsx,ts,tsx,md,mdx}\" --show-suggestions",
        "prepare": "husky",
        "precommit": "lint-staged",
        "test": "tsx --test src/lib/__tests__/**/*.test.ts scraper/__tests__/**/*.test.ts",
        "scrape": "tsx scraper/index.ts",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
        "db:push": "drizzle-kit push --config=drizzle.config.ts",
        "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
        "db:seed": "tsx scripts/seed.ts",
        "db:export-sample": "tsx scripts/export-sample-reviews.ts",
        "reviews:reclassify": "tsx scripts/reclassify-reviews.ts",
        "reviews:embed": "tsx scripts/embed-reviews.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@openrouter/ai-sdk-provider": "^3.0.0",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-avatar": "^1.1.10",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@tanstack/react-query": "^5.101.4",
        "@upstash/redis": "^1.38.2",
        "@vercel/functions": "^3.9.3",
        "ai": "^7.0.65",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.3",
        "drizzle-orm": "^0.44.6",
        "geist": "^1.7.2",
        "lucide-react": "^0.546.0",
        "next": "16.3.1",
        "next-themes": "^0.4.6",
        "nextjs-toploader": "^3.9.17",
        "pg": "^8.16.3",
        "radix-ui": "^1.6.7",
        "react": "^19.2.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.65.0",
        "recharts": "^3.8.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.7",
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@tailwindcss/postcss": "^4.1.15",
        "@tanstack/react-query-devtools": "^5.101.4",
        "@types/node": "^24.9.1",
        "@types/pg": "^8.15.5",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "cspell": "^9.2.2",
        "drizzle-kit": "^0.31.5",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "playwright": "^1.55.1",
        "tailwindcss": "^4.1.15",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@9.12.2+sha512.22721b3a11f81661ae1ec68ce1a7b879425a1ca5b991c975b074ac220b187ce56c708fe5db69f4c962c989452eee76c82877f4ee80f474cebd61ee13461b6228"
}
